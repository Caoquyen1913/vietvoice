<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VietVoice"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dịch tiếng Trung → Việt real-time"
                android:textSize="12sp"
                android:textColor="@color/subtitle" />

        </LinearLayout>

    </LinearLayout>

    <!-- Models card: Vosk + TTS combined -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Models"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textColor="@color/subtitle"
                android:layout_marginBottom="12dp" />

            <!-- Vosk STT row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎙 Nhận dạng tiếng Trung"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/tv_model_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Chưa tải (~42MB)"
                    android:textSize="12sp"
                    android:textColor="@color/subtitle"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_download_model"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Tải"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:visibility="gone"
                android:progressTint="@color/primary"
                android:layout_marginBottom="10dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="10dp" />

            <!-- TTS voice row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔊 Giọng đọc tiếng Việt"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/tv_tts_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Chưa tải (~67MB)"
                    android:textSize="12sp"
                    android:textColor="@color/subtitle"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_download_tts"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Tải"
                    android:textSize="12sp"
                    android:textColor="@color/primary"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar_tts"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="100"
                android:visibility="gone"
                android:progressTint="@color/primary" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Control card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_start_stop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="▶  Bắt đầu"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/green"
                android:enabled="false"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vui lòng tải model trước"
                android:textSize="12sp"
                android:textColor="@color/subtitle"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hiển thị bảng transcript"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_transcript"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Live transcript card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transcript"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textColor="@color/subtitle"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tv_original"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="15sp"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="10dp"
                android:hint="🇨🇳 Giọng tiếng Trung sẽ hiện ở đây..."
                android:textColorHint="@color/subtitle" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tv_translated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="15sp"
                android:textColor="@color/primary"
                android:hint="🇻🇳 Bản dịch tiếng Việt..."
                android:textColorHint="@color/subtitle" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Footer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nhấn giữ nút nổi để bật/tắt bảng transcript"
        android:textSize="11sp"
        android:textColor="@color/subtitle"
        android:gravity="center"
        android:paddingBottom="16dp" />

</LinearLayout>
